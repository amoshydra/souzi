{
  "name": "souzi",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "type": "module",
  "description": "Souzi \u2014 an offline-first English\u2013Chinese dictionary app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:ecdict": "node scripts/build-ecdict-core.mjs",
    "cap:sync": "cap sync",
    "cap:sync:android": "cap sync android",
    "cap:open:android": "cap open android",
    "android:debug": "pnpm build && cap sync android && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "fflate": "^0.8.2",
    "idb": "^8.0.3",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "csv-parse": "^7.0.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vite-plugin-pwa": "^1.0.0",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22"
  }
}
